# ==============================================
# Runner App Backend - variables de entorno
# Copia a .env (local) o configúralas en Railway (staging/prod).
# ==============================================

# --- Runtime ---
NODE_ENV=development          # development | staging | production
PORT=3000                     # Railway inyecta este valor automáticamente

# --- Base de datos (Prisma / PostgreSQL) ---
# LOCAL (docker-compose): puerto host 5433
DATABASE_URL=postgresql://user:password@localhost:5433/running_app
#
# SUPABASE - IMPORTANTE:
#  · Migraciones (prisma migrate deploy) -> conexión DIRECTA, puerto 5432:
#      postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
#  · Runtime en Railway -> conexión POOLED (pgBouncer), puerto 6543:
#      postgresql://postgres.[REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#  Si sólo defines una, usa la directa (5432): funciona para ambos aunque escale peor.

# --- JWT ---
JWT_SECRET=cambia-esto-por-un-secreto-de-32-o-mas-caracteres
JWT_REFRESH_SECRET=otro-secreto-distinto-de-32-o-mas-caracteres
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:5173,http://localhost:4200

# --- Seed (prisma/seed.ts) ---
# Contraseñas de los usuarios de ejemplo creados por `npm run db:seed`.
# Si no se definen, se usan valores por defecto SOLO aptos para desarrollo local.
SEED_SUPERADMIN_PASSWORD=cambia-esto-en-produccion
SEED_ADMIN_PASSWORD=cambia-esto-en-produccion
SEED_ATHLETE_PASSWORD=cambia-esto-en-produccion
SEED_COACH_PASSWORD=cambia-esto-en-produccion
