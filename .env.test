# Configuración de la suite E2E (test/e2e/**).
# La cargan vitest.config.e2e.ts y test/e2e/global-setup.ts.
# Las variables ya presentes en el entorno tienen prioridad sobre este archivo.

# ---------------------------------------------------------------------------
# URL base de la API.
#   · pnpm test:e2e          -> ignora esto y usa http://localhost:3000
#                               (si no responde, arranca el server local)
#   · pnpm test:e2e:staging  -> usa el BASE_URL de aquí abajo; si es local,
#                               falla pidiéndote la URL real.
#
# Para correr contra Railway: descomenta y pon TU URL real (sin barra final).
# BASE_URL=https://backend-running-production.up.railway.app
BASE_URL=http://localhost:3000
# ---------------------------------------------------------------------------

# Prefijo global de la API (coincide con app.setGlobalPrefix en src/main.ts).
API_PREFIX=/api/v1

# Presupuesto de latencia para los tests de "performance básico" (ms).
# Contra una BD remota conviene subirlo, p.ej. 5000.
PERF_BUDGET_MS=2000

# Reintentos por test. Por defecto 0 en local, 1 contra staging/prod.
# E2E_RETRY=1
