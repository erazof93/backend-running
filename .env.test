# Configuración de la suite E2E (test/e2e/**).
# Se carga automáticamente desde test/e2e/global-setup.ts si existe.
# Las variables ya presentes en el entorno tienen prioridad sobre este archivo.

# URL base de la API a testear.
#   local:   http://localhost:3000  -> si no responde, la suite arranca el server
#   staging: la URL REAL de Railway, p.ej. https://backend-running-production.up.railway.app
#            (debe estar desplegada; global-setup valida GET /health -> 200)
BASE_URL=http://localhost:3000

# Prefijo global de la API (coincide con app.setGlobalPrefix en src/main.ts).
API_PREFIX=/api/v1

# Presupuesto de latencia para los tests de "performance básico" (ms).
# Contra staging conviene subirlo (BD remota): p.ej. 5000.
PERF_BUDGET_MS=2000

# Reintentos por test. Vacío = 0 en local, 1 contra staging/prod.
# E2E_RETRY=1

# --- Para correr contra staging ---
# 1) Despliega la app en Railway (ver railway.json + guía del deploy).
# 2) Pon aquí BASE_URL=https://TU-URL-REAL.up.railway.app  (sin barra final)
#    o edita el script "test:e2e:staging" en package.json con esa URL.
# 3) pnpm test:e2e:staging
