# Configuración de la suite E2E (test/e2e/**).
# Se carga automáticamente desde test/e2e/global-setup.ts si existe.
# Las variables ya presentes en el entorno tienen prioridad sobre este archivo.

# URL base de la API a testear.
#   local:   http://localhost:3000   (si no responde, la suite arranca el server)
#   staging: https://<tu-app>.up.railway.app   (debe estar desplegada)
BASE_URL=http://localhost:3000

# Prefijo global de la API (coincide con app.setGlobalPrefix en src/main.ts).
API_PREFIX=/api/v1

# Presupuesto de latencia para los tests de "performance básico" (ms).
PERF_BUDGET_MS=2000
